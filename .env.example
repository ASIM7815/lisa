# ---------------------------------------------------------------------------
# LISA environment configuration
# Copy to `.env` and fill in. NEVER commit real secrets. Never expose any of
# these to the browser: LISA reads them only inside Next.js route handlers /
# server components. Keys prefixed NEXT_PUBLIC_ are the only ones that reach
# the client bundle, and none of the secrets below use that prefix.
# ---------------------------------------------------------------------------

# --- Groq (LISA's LLM) -----------------------------------------------------
# Create/rotate keys at https://console.groq.com/keys
# If a key ever leaks: revoke it in the console immediately, then rotate here.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_MS=30000
GROQ_MAX_RETRIES=2

# --- Hindsight (long-term agent memory) ------------------------------------
# Hindsight Cloud: https://api.hindsight.vectorize.io  (Connect page -> API key)
# Self-hosted:     http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_TENANT=default
HINDSIGHT_BANK=lisa-operations
HINDSIGHT_TIMEOUT_MS=20000

# --- PostgreSQL (permanent case / business data) ---------------------------
# Leave empty to use the local file store in .lisa/data.json (dev + demo only).
# On Vercel/Neon use the *pooled* connection string.
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_SSL=require

# --- Redis (cache, recall cache, rate limiting) ----------------------------
# Leave empty to use the in-process cache (single instance only).
REDIS_URL=
REDIS_KEY_PREFIX=lisa:

# --- Application -----------------------------------------------------------
NODE_ENV=development
# Single shared operator token guarding /api/*. Leave empty to disable the gate
# (fine for a local demo, not for a deployed instance).
LISA_API_TOKEN=
LISA_LOG_LEVEL=info
# Requests per minute per token/IP for write endpoints.
LISA_RATE_LIMIT_PER_MINUTE=120
# Auto-run schema migrations against Postgres on first request.
LISA_AUTO_MIGRATE=true
